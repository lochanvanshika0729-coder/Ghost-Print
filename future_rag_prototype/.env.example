# Optional OpenAI-compatible LLM generation. Retrieval-only mode works without these.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
# Optional full endpoint override, e.g. https://provider.example/v1/chat/completions
# LLM_CHAT_COMPLETIONS_URL=

# Optional override for the local open-source embedding model.
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

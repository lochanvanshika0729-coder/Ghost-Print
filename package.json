{
  "name": "ghostguard-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Local launcher for the GHOSTGUARD deletion audit workspace",
  "scripts": {
    "predev": "npm run build:pattern-waves",
    "dev": "node code/server.js",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node code/server.js",
    "api": "npm --prefix code run api",
    "build:pattern-waves": "vite build --config vite.pattern-waves.config.mjs",
    "start": "node code/server.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "export": "node code/server.js --export",
    "validate": "node code/validate-output.js",
    "test": "npm --prefix code test",
    "evaluate:sample": "npm --prefix code run evaluate:sample"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@xyflow/react": "^12.12.1",
    "lucide-react": "^1.68.0",
    "motion": "^14.9.1",
    "ogl": "^1.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "vite": "^8.3.5"
  }
}

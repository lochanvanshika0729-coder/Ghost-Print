# Node's optional local FastAPI AI service proxy. Keep this on loopback.
GHOSTGUARD_AI_URL=http://127.0.0.1:8001

# Ollama runs locally. No API keys or cloud model providers are used.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
AI_REQUEST_TIMEOUT=90

# Use the local Ollama embedding model for semantic retrieval.
RAG_EMBEDDING_PROVIDER=ollama
# Optional alternative: sentence-transformers, with weights cached before runtime.
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CACHE_PATH=backend/ai_rag.sqlite3
RAG_MAX_RESULTS=8
AI_MAX_EVIDENCE_CHARS=12000

# Local FastAPI development defaults.
GHOSTGUARD_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
